{
  "name": "dsh-research-kit",
  "version": "0.3.0",
  "description": "面向 DeepSeek Harness 的科研 Agent 工作台：351 条工作流、109 个技能条目、129 个科学数据源，支持公开 API 直查与 DSH Agent/MCP 查询回退。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./ui/client.js"
  },
  "bin": {
    "dsh-research-kit-mcp": "./mcp/server.js"
  },
  "files": [
    "catalog",
    "src",
    "mcp",
    "ui",
    "dsh",
    "vendor",
    "presets",
    "scripts",
    "docs",
    "test",
    "README.md",
    "README.en.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "ROADMAP.md",
    "NOTICE",
    "LICENSE",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "author": "cuijiaqi <cjqzazj@gmail.com>",
  "homepage": "https://github.com/fsrmqi/dsh-research-kit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/fsrmqi/dsh-research-kit.git"
  },
  "bugs": {
    "url": "https://github.com/fsrmqi/dsh-research-kit/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "research",
    "academic-writing",
    "peer-review",
    "workflow",
    "prompt"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "baselines:fetch": "bash scripts/fetch-baselines.sh",
    "check:dsh-app": "node scripts/check-dsh-app.mjs",
    "check:test-count": "node scripts/check-test-count.mjs",
    "coverage": "node scripts/check-coverage.mjs",
    "coverage:ci": "node scripts/check-coverage.mjs --with-docs",
    "coverage:update": "node scripts/check-coverage.mjs --update",
    "verify": "npm run check && npm test && npm run check:dsh-app && npm run coverage:ci",
    "dev:register": "bash scripts/register.sh",
    "dev:watch": "bash scripts/watch.sh",
    "dev:web": "bash scripts/web.sh",
    "mcp": "node mcp/server.js",
    "check": "node --experimental-vm-modules --no-warnings scripts/check-syntax.mjs && node scripts/check-vendor.mjs && node scripts/validate-catalog.mjs && node scripts/validate-diagrams.mjs --repo && node scripts/sync-tool-docs.mjs --check && node scripts/check-doc-stats.mjs && node scripts/check-doc-assets.mjs && node scripts/check-client-budget.mjs",
    "test": "npm run build && node --test \"test/*.test.js\" \"test/*.test.mjs\"",
    "test:browser": "npm run build && node scripts/browser-regression.cjs",
    "prepublishOnly": "npm run check && npm test && npm run check:dsh-app && npm run check:test-count"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-0 <0.1.8-0 || >=0.2.0-0 <0.2.1-0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@deepseek-ai/schemastery": "^3.18.1",
    "zod": "^4.6.5"
  }
}
